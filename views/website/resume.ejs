  <%- include('header') %>
  <section id="resume" class="resume">
        <div class="container">
            <div class="section-header">
                <span class="section-tag">Resume</span>
                <h2 class="section-title">My Skills &amp; Expertise</h2>
                <p class="section-desc">A snapshot of my technical capabilities and professional experience</p>
            </div>
            
            <div class="resume-grid">
                <!-- Technical Skills -->
                <div class="skills-container">
                    <h3>Technical Skills</h3>
                    
                    <% for(let i=0;i<ts.length;i++) {%>
                    <div class="skill-item">
                        <div class="skill-header">
                            <span class="skill-name"><%=ts[i].tech_name%></span>
                            <span class="skill-percent"><%=ts[i].tech_per%>%</span>
                        </div>
                        <div class="progress-bar">
                            <div class="progress-fill" data-width="95"></div>
                        </div>
                    </div>
                    <% } %>
                </div>
                
                <!-- Experience Timeline -->
                <div class="timeline-container">
                    <h3>Experience</h3>
                    
                    <% for(let i=0;i<exp.length;i++){ %>
                    <div class="timeline">
                        <div class="timeline-item">
                            <div class="timeline-dot"></div>
                            <div class="timeline-content">
                                <span class="timeline-date"><%=exp[i].exp_year %></span>
                                <h4><%=exp[i].exp_position %></h4>
                                <p class="timeline-company"><%=exp[i].exp_company %></p>
                                <p><%=exp[i].exp_desc %>.</p>
                            </div>
                        </div>
                      
                       
                    </div>
                     <% } %> 
                    
                    <h3 style="margin-top: 40px;">Education</h3>
                    <% for(let i=0;i<edu.length;i++){ %>
                    <div class="timeline">
                        <div class="timeline-item">
                            <div class="timeline-dot"></div>
                            <div class="timeline-content">
                                <span class="timeline-date"><%=edu[i].edu_year%></span>
                                <h4><%=edu[i].edu_position%></h4>
                                <p class="timeline-company"><%=edu[i].edu_company%></p>
                            </div>
                        </div>
                        
                       
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
    </section>

    <%- include('footer') %>