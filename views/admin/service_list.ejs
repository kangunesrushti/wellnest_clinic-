<%- include('header.ejs'); %>

            <!-- ===== DASHBOARD CONTENT ===== -->
            <div class="page-content">
                <div class="container-fluid">
                    <!-- Page Header -->
                    <div class="page-header d-flex justify-content-between align-items-center">
                        <div>
                            <h1 class="h3 mb-1">Service List</h1>
                            <p class="text-muted small mb-0">Welcome back, Admin! Here's your overview</p>
                        </div>
                               <button style="background-color: #6c63ff; color: white; padding: 5px; margin: 5px;
                        border-radius: 5px; text-decoration: none; border: none;">
                        <a href="/admin/service_add" style="color: white;">Add Service</a></button>
                    </div>

                   
                    <!-- star cards  -->
                     <div class="row g-4  ">
                        <div class="col-12">
                          <table border="1" class="table table-border">
                            <tr>
                                <th>Id</th>
                                <th>Service Icon</th>
                                <th>Service Name</th>
                                  <th>Description</th>
                               
                                <th>Actions</th>
                            </tr>
                            <% for(let i=0;i<service.length;i++){ %>
                            <tr>
                                <td><%=i+1 %></td>
                                <td><%=service[i].service_icon %></td>
                                <td><%=service[i].service_name %></td>
                                <td><%=service[i].service_desc %></td>
                                <td>
                                    <a href="/admin/service_update/<%=service[i].sid %>"  ><button class="btn btn-warning"><i class="fa fa-pencil"></i></button></a>
                                    <a href="/admin/service_delete/<%=service[i].sid %>"  ><button class="btn btn-danger"><i class="fa fa-trash"></i></button></a>
                                </td>
                            </tr>
                            <% }%>
                          </table>
                        </div>

                     </div>
                   
                </div>
            </div>
          <%- include('footer.ejs'); %>