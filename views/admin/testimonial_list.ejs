
<%- include('header.ejs'); %>

<!-- ===== DASHBOARD CONTENT ===== -->
<div class="page-content">
    <div class="container-fluid">

        <!-- Page Header -->
        <div class="page-header d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h3 mb-1">Testimonial List</h1>
                <p class="text-muted small mb-0">Manage all testimonials</p>
            </div>

            <a href="/admin/testimonial_add" class="btn btn-primary">
                <i class="fa fa-plus"></i> Add Testimonial
            </a>
        </div>

        <!-- Testimonial Table -->
        <div class="row g-4">
            <div class="col-12">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Designation</th>
                            <th>Company</th>
                            <th>Description</th>
                            <th>Rating</th>
                            <th>Image</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% for(let i = 0; i < testimonial.length; i++) { %>
                        <tr>
                            <td><%= i + 1 %></td>

                            <td><%= testimonial[i].name %></td>

                            <td><%= testimonial[i].designation %></td>

                            <td><%= testimonial[i].company %></td>

                            <td><%= testimonial[i].description %></td>

                            <td>
                                <% for(let j = 1; j <= testimonial[i].rating; j++) { %>
                                    <i class="fa fa-star text-warning"></i>
                                <% } %>
                            </td>

                            <td>
                                <img src="/<%= testimonial[i].img %>" width="80" height="60" class="rounded">
                            </td>

                            <td>
                                <a href="/admin/testimonial_update/<%=testimonial[i].id %>"  class="btn btn-warning btn-sm">
                                    <i class="fa fa-pencil"></i>
                                </a>

                                <a href="/admin/testimonial_delete/<%=testimonial[i].id %>" class="btn btn-danger btn-sm">
                                    <i class="fa fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                        <% } %>
                    </tbody>

                </table>
            </div>
        </div>

    </div>
</div>

<%- include('footer.ejs'); %>

