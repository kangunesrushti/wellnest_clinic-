```ejs
<%- include('header.ejs'); %>

<!-- ===== DASHBOARD CONTENT ===== -->
<div class="page-content">
    <div class="container-fluid">

        <!-- Page Header -->
        <div class="page-header d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h3 mb-1">Portfolio List</h1>
                <p class="text-muted small mb-0">Manage all portfolio posts</p>
            </div>

            <a href="/admin/portfolio_add" class="btn btn-primary">
                <i class="fa fa-plus"></i> Add Portfolio
            </a>
        </div>

        <!-- Blog Table -->
        <div class="row g-4">
            <div class="col-12">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Project Name</th>
                            <th>Image</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% for(let i = 0; i < portfolio.length; i++) { %>
                        <tr>
                            <td><%= i + 1 %></td>
                            <td><%= portfolio[i].p_name %></td>
                            <td>
                                <img src="/<%= portfolio[i].img %>" width="80" height="60">
                            </td>
                            <td>
                                <a href="/admin/portfolio_update/<%=portfolio[i].pid %>" class="btn btn-warning btn-sm">
                                    <i class="fa fa-pencil"></i>
                                </a>

                                <a href="/admin/portfolio_delete/<%=portfolio[i].pid %>" class="btn btn-danger btn-sm">
                                    <i class="fa fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

<%- include('footer.ejs'); %>
```
