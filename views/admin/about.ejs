<%- include('header.ejs'); %>

            <!-- ===== DASHBOARD CONTENT ===== -->
            <div class="page-content">
                <div class="container-fluid">
                    <!-- Page Header -->
                    <div class="page-header d-flex justify-content-between align-items-center">
                        <div>
                            <h1>About Section</h1>
                            <p class="text-muted small mb-0">Welcome back, Admin! Here's your overview</p>
                        </div>
                        
                    </div>

                   
                    <!-- star cards  -->
                     <div class="row g-4  ">
                        <div class="col-12">
                           <form action="/admin/about_save" method="post" enctype="multipart/form-data">

    <label>Name</label>
    <input
        type="text"
        class="form-control mb-3"
        name="name"
        value="<%= about.name %>"
    >

    <label>Email</label>
    <input
        type="email"
        class="form-control mb-3"
        name="email"
        value="<%= about.email %>"
    >

    <label>Location</label>
    <input
        type="text"
        class="form-control mb-3"
        name="location"
        value="<%= about.location %>"
    >

    <label>Freelance</label>
    <input
        type="text"
        class="form-control mb-3"
        name="freelance"
        value="<%= about.freelance %>"
        placeholder="Available / Not Available"
    >

    <label>Experience</label>
    <input
        type="text"
        class="form-control mb-3"
        name="experience"
        value="<%= about.experience %>"
        placeholder="e.g. 5+ Years"
    >

    <label>Position</label>
    <input
        type="text"
        class="form-control mb-3"
        name="position"
        value="<%= about.position %>"
    >

    <label>Description</label>
    <textarea
        class="form-control mb-3"
        name="description"
        rows="5"
    ><%= about.description %></textarea>

    <label>Image</label>
    <input
        type="hidden"
        name="old_img"
        value="<%= about.img %>"
    >

    <input
        type="file"
        class="form-control mb-3"
        name="img"
    >

   
        <img
            src="/<%= about.img %>"
            alt="About Image"
            width="100"
            height="100"
            class="mb-3"
        >
  

    <button type="submit" class="btn btn-primary">Save</button>

</form>
                        </div>

                     </div>
                   
                </div>
            </div>
          <%- include('footer.ejs'); %>