<%- include('header.ejs'); %>

            <!-- ===== DASHBOARD CONTENT ===== -->
            <div class="page-content">
                <div class="container-fluid">
                    <!-- Page Header -->
                    <div class="page-header d-flex justify-content-between align-items-center">
                        <div>
                            <h1>Hero Section</h1>
                            <p class="text-muted small mb-0">Welcome back, Admin! Here's your overview</p>
                        </div>
                        
                    </div>

                   
                    <!-- star cards  -->
                     <div class="row g-4  ">
                        <div class="col-12">
                            <form action="/admin/hero_save" method="post" enctype="multipart/form-data">
                                <label for="">Name</label>
                                <input type="text" class="form-control mb-4" name="name" value="<%=hero.name%>">

                                  <label for="">Designation</label>
                                <input type="text" class="form-control mb-4" name="designation"  value="<%=hero.designation%>">

                                  <label for="">Description</label>
                                <input type="text" class="form-control mb-4" name="description" value="<%=hero.description%>">
                               
                                <label for="">Image</label>  
                                <input type="hidden" name="old_img"  value="<%=hero.img%>">                             
                                <input type="file" class="form-control mb-4" name="img">
                                <img src="/<%=hero.img%>" alt="" width="50px" height="50px">
                                <button class="btn btn-primary">Save</button>
                            </form> 
                        </div>

                     </div>
                   
                </div>
            </div>
          <%- include('footer.ejs'); %>